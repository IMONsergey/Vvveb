FROM php:8.4-cli-alpine

ARG IMON_BOOTSTRAP_SHA=4a77cdd4ae0bd7ce92a80ff860193a50df1a45f0

RUN set -eux; \
    apk add --no-cache git; \
    git clone https://github.com/IMONsergey/Vvveb.git /opt/imon-vvveb-deploy; \
    cd /opt/imon-vvveb-deploy; \
    git checkout "$IMON_BOOTSTRAP_SHA"; \
    chmod +x vercel/build-runtime.sh; \
    vercel/build-runtime.sh; \
    rm -rf /opt/imon-vvveb-deploy

# Vercel container functions route to port 80 unless PORT is explicitly
# overridden in project settings. Keep the image compatible with both cases.
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${PORT:-80}/__health" >/dev/null || exit 1

CMD ["/usr/local/bin/vvveb-start"]
