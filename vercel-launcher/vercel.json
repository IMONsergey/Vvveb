{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/proxy.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/proxy"
    }
  ],
  "crons": [
    {
      "path": "/__warm",
      "schedule": "*/5 * * * *"
    }
  ]
}
